@{
    var cssClasses = new List<string> { "section-rail-button" };

    if (Active)
        cssClasses.Add("active");
}

<button type="button" class="@string.Join(" ", cssClasses)" title="@Title" @onclick="ButtonClickAsync" @onclick:preventDefault="true">
    @Shared.RenderFragments.Icon(this)
</button>
