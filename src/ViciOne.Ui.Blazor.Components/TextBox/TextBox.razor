@using ViciOne.Ui.Blazor.Components.Extensions

@{
    var cssClasses = new List<string> { "text-box" };

    if (!string.IsNullOrWhiteSpace(CssClass))
        cssClasses.AddRange(CssClass.Split(" "));

    this.WithInputValidationStyling(cssClasses);

    var attributes = new Dictionary<string, object>();
    if (ReadOnly)
        attributes.Add("readonly", "readonly");

    if (!Enabled)
        attributes.Add("disabled", "disabled");

    if (!string.IsNullOrWhiteSpace(Placeholder))
        attributes.Add("placeholder", Placeholder);

    if (!string.IsNullOrWhiteSpace(InputMode))
        attributes.Add("inputmode", InputMode);

    if (!string.IsNullOrWhiteSpace(AutoComplete))
        attributes.Add("autocomplete", AutoComplete);

    if (!string.IsNullOrWhiteSpace(Name))
        attributes.Add("name", Name);

    if (!string.IsNullOrWhiteSpace(Id))
        attributes.Add("id", Id);

    if (SpellCheck.HasValue)
        attributes.Add("spellcheck", SpellCheck.Value ? "true" : "false");

    var type = Password ? "password" : "text";
}

@* Using @bind:event instead of value="..." @oninput="..." due to https://gitlab.com/vicione-oss/vicione/ui-libs/blazor-components/-/merge_requests/63#note_3245777960 *@
<input class="@string.Join(" ", cssClasses)"
       type="@type"
       @attributes="@attributes"
       @bind="_valueEntered"
       @bind:event="oninput"
       @bind:after="@AfterOnInput"
       @onkeyup="@InputKeyUpAsync"
       @onblur="@InputBlurAsync"
       @ref="_inputElementReference" />
