@using ViciOne.Ui.Blazor.Components.DropDown
@using ViciOne.Ui.Blazor.Components.Extensions
@using ViciOne.Ui.Blazor.Components.TextBox
@using ViciOne.Ui.MonochromeIcons.Components
@using ViciOne.Ui.MonochromeIcons.Core.Enums

@typeparam TItem
@typeparam TValue

@{
    var cssClasses = new List<string> { "combo-box" };

    if (!string.IsNullOrWhiteSpace(CssClass))
        cssClasses.AddRange(CssClass.Split(" "));

    if (!Enabled)
        cssClasses.Add("disabled");

    else if (ReadOnly)
        cssClasses.Add("read-only");

    var inputCssClasses = new List<string> { "combo-box-input" };

    this.WithInputValidationStyling(inputCssClasses);
}

<div class="@string.Join(" ", cssClasses)">
    <div class="input-wrapper">
        <TextBox @ref="_textBox"
                 CssClass="@string.Join(" ", inputCssClasses)"
                 Enabled="Enabled"
                 TabIndex="@(Enabled && ReadOnly ? -1 : (int?)null)"
                 Value="@_inputValue"
                 ValueChanging="InputValueChangingAsync"
                 EnterPressed="InputEnterPressedAsync"
                 OnClick="OpenOrCloseDropdownAsync"
                 FocusLost="CloseDropdownAsync" />
    </div>

    <MonochromeIcon CssClass="drop-down-icon" Name="MonochromeIconName.ExpanderLightDown" Size="MonochromeIconSize.Small" />

    <DropDown TItem="OptionDescriptor"
              @ref="_dropDown"
              InputElementReference="_textBox?.InputElementReference"
              Items="GetFilteredOptionDescriptors()"
              SelectedItems="GetSelectedOptionDescriptors()"
              SelectedItemsChanged="DropdownSelectedItemsChangedAsync">

        <ItemTemplate>
            @context.Text
        </ItemTemplate>
    </DropDown>
</div>
