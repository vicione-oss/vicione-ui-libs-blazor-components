@using ViciOne.Ui.MonochromeIcons.Components
@using ViciOne.Ui.MonochromeIcons.Core.Enums

@{
    var cssClasses = new List<string> { "property-editor-tool-tip" };

    if (!string.IsNullOrWhiteSpace(CssClass))
        cssClasses.AddRange(CssClass.Split(" "));
}

<div class="@string.Join(" ", cssClasses)">
    @if (HasCloseButton)
    {
        <button type="button" class="btn close-button" @onclick="CloseButtonClickAsync">
            <MonochromeIcon Name="MonochromeIconName.CloseMedium" Size="MonochromeIconSize.Small" />
        </button>
    }

    @Content

    @if (AfterContent is not null)
    {
        <div class="separator" />

        @AfterContent
    }
</div>
