@using ViciOne.Ui.Blazor.Components.Extensions
@using ViciOne.Ui.MonochromeIcons.Components
@using ViciOne.Ui.MonochromeIcons.Core.Enums

@typeparam TItem
@typeparam TValue

@{
    var cssClasses = new List<string> { "combo-box" };

    if (CssClass is not null)
        cssClasses.AddRange(CssClass.Split(" "));

    if (!Enabled)
        cssClasses.Add("disabled");

    else if (ReadOnly)
        cssClasses.Add("read-only");

    var selectCssClasses = new List<string>();

    if (_restoreFocus)
    {
        // At this point we will render a new select element which will replace the one
        // currently visible in the browser. Because the new element will receive focus
        // in OnAfterRenderAsync() the element will appear not focused for a tiny fraction
        // of time which results in visual flicker. So, we fix the flickering by making
        // the new element appear focused until it receives actual focus.
        selectCssClasses.Add("appear-focused");
    }

    this.WithInputValidationStyling(selectCssClasses);

    var selectAttributes = new Dictionary<string, object>();

    if (selectCssClasses.Count > 0)
        selectAttributes.Add("class", string.Join(" ", selectCssClasses));

    if (!Enabled)
        selectAttributes.Add("disabled", "disabled");
    else if (ReadOnly)
        selectAttributes.Add("tabindex", "-1");
}

<div class="@string.Join(" ", cssClasses)">
    <select @ref="_selectElementReference"
            @key="_selectElementKey"
            @attributes="@selectAttributes"
            @onchange="SelectChangedAsync"
            @onfocus="SelectFocus"
            @onblur="SelectBlur">
        @foreach (var optionDescriptor in _optionDescriptors)
        {
            <option @attributes="optionDescriptor.Attributes">@optionDescriptor.Text</option>
        }

        @if (!_isAnyOptionSelected)
        {
            <option selected disabled></option>
        }
    </select>

    <MonochromeIcon CssClass="drop-down-icon" Name="MonochromeIconName.Chevron" Size="MonochromeIconSize.Small" />
</div>
