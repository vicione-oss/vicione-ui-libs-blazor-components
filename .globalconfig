dotnet_diagnostic.VO2001.severity = warning # Members should be grouped by type, then sorted in predefined order

dotnet_diagnostic.VO2002.severity = warning # Wrong field order
vicione_code_quality.VO2002.with_alphabetical_order = false # Wrong field order, fields should be grouped by keyword only, no alphabetical ordering in the second pass
vicione_code_quality.VO2002.with_const_fields_grouped_by_access_modifier = true

dotnet_diagnostic.VO2003.severity = none # Properties should be grouped by first attribute, then sorted in alphabetical order
dotnet_diagnostic.VO2004.severity = none # Events should be sorted in alphabetical order
dotnet_diagnostic.VO2005.severity = warning # Constructors should be grouped by keyword, then sorted by number of parameters in ascending order
dotnet_diagnostic.VO2006.severity = none # Methods should be sorted in alphabetical order
dotnet_diagnostic.VO2008.severity = none # Property assignments in the object initializer are not sorted alphabetically by property name
dotnet_diagnostic.VO2009.severity = none # Property assignments in the constructor are not sorted alphabetically by property name

dotnet_diagnostic.ROS0003.severity = error # Report missing options leading to non-working analyzers

dotnet_diagnostic.RCS0061.severity = warning # Add / remove blank line between switch sections
roslynator_blank_line_between_switch_sections = include

dotnet_diagnostic.RCS1021.severity = warning # Convert lambda expression body to expression body
dotnet_diagnostic.RCS1037.severity = warning # Remove trailing white-space
dotnet_diagnostic.RCS1047.severity = warning # Non-asynchronous method name should not end with 'Async'
dotnet_diagnostic.RCS1085.severity = warning # Use auto-implemented property
dotnet_diagnostic.RCS1107.severity = warning # Remove redundant 'ToCharArray' call
dotnet_diagnostic.RCS1118.severity = warning # Mark local variable as const
dotnet_diagnostic.RCS1146.severity = warning # Use conditional access
dotnet_diagnostic.RCS1158.severity = warning # Static member in generic type should use a type parameter
dotnet_diagnostic.RCS1163.severity = warning # Unused parameter, in addition to sometimes not working CA1801 and IDE0060
dotnet_diagnostic.RCS1170.severity = warning # Use read-only auto-implemented property
dotnet_diagnostic.RCS1171.severity = warning # Simplify lazy initialization
dotnet_diagnostic.RCS1205.severity = warning # Order named arguments according to the order of parameters
dotnet_diagnostic.RCS1213.severity = warning # Remove unused member declaration
dotnet_diagnostic.RCS1226.severity = warning # Add paragraph to documentation comment
dotnet_diagnostic.RCS1235.severity = warning # Optimize method call
dotnet_diagnostic.RCS1243.severity = warning # Duplicate word in a comment
dotnet_diagnostic.RCS1246.severity = warning # Use element access
dotnet_diagnostic.RCS1251.severity = warning # Remove unnecessary braces from record declaration

dotnet_diagnostic.RCS1254.severity = warning # Normalize format of enum flag value
roslynator_enum_flag_value_style = decimal_number

dotnet_diagnostic.RCS1259.severity = warning # Remove empty syntax
dotnet_diagnostic.RCS1261.severity = warning # Resource can be disposed asynchronously
dotnet_diagnostic.RCS1236.severity = warning # Use exception filter
dotnet_diagnostic.RCS1249.severity = warning # Unnecessary null-forgiving operator
