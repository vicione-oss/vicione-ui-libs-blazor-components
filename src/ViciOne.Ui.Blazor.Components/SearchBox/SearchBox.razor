@using ViciOne.Ui.Blazor.Components.Extensions
@using ViciOne.Ui.Blazor.Components.Shared
@using ViciOne.Ui.Blazor.Components.TextBox
@using ViciOne.Ui.MonochromeIcons.Components
@using ViciOne.Ui.MonochromeIcons.Core.Enums

@{
    var searchBoxCssClasses = new List<string> { "search-box" };

    if (!string.IsNullOrWhiteSpace(CssClass))
        searchBoxCssClasses.AddRange(CssClass.Split(" "));
}

<div class="@string.Join(" ", searchBoxCssClasses)">
    <TextBox CssClass="search-box-input"
             Placeholder="@Placeholder"
             Value="@Text"
             ValueChanging="@TextBoxValueChangingAsync"
             ValueChanged="@TextBoxValueChangedAsync"
             EnterPressed="@TextBoxEnterPressedAsync"
             Enabled="@Enabled"
             @ref="_textBox" />

    @{
        var showClearButton = _isSomeTextEntered && Enabled;
        
        var clearButtonAttributes = new Dictionary<string, object>();
        var clearButtonCssClasses = new List<string> { "clear-button" };
        
        if (!showClearButton)
        {
            clearButtonCssClasses.Add("hidden");

            clearButtonAttributes.Add("tabindex", "-1"); // do not focus when tabbing
        }

        if (_animateTransitions)
            clearButtonCssClasses.Add("animate-transition");

        clearButtonAttributes.Add("class", string.Join(" ", clearButtonCssClasses));

        if (!showClearButton || !Enabled)
            clearButtonAttributes.Add("disabled", "disabled");
    }
    <button @attributes="clearButtonAttributes" @onclick="@ClearButtonClickAsync">
        <MonochromeIcon Name="MonochromeIconName.Clear" Size="@IconSize" />
    </button>

    @{
        var iconContainerCssClasses = new List<string> { "icon-container" };

        if (showClearButton)
            iconContainerCssClasses.Add("hidden");
        else if (!Enabled)
            iconContainerCssClasses.Add("disabled");

        if (_animateTransitions)
            iconContainerCssClasses.Add("animate-transition");
    }
    <div class="@string.Join(" ", iconContainerCssClasses)">
        @if (this.IsAnyIconParameterSet())
        {
            @RenderFragments.Icon(this)
        }
        else
        {
            <MonochromeIcon Name="MonochromeIconName.Search" Size="@IconSize" />
        }
    </div>
</div>
