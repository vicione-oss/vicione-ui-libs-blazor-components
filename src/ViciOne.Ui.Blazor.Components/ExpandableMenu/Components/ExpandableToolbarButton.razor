@using ViciOne.Ui.Blazor.Components.Shared
@using ViciOne.Ui.MonochromeIcons.Components
@using ViciOne.Ui.MonochromeIcons.Core.Enums

@if (Entry.Visible)
{
    var cssClasses = new List<string> { "expandable-toolbar-button" };

    var expanded = Entry.IsExpanded;
    if (expanded)
        cssClasses.Add("expanded");

    var isCompact = MenuService.IsCompact;
    if (isCompact)
        cssClasses.Add("compact");

    var buttonAttributes = new Dictionary<string, object>();

    if (!isCompact && expanded && !Entry.IsSticky)
        buttonAttributes.Add("tabindex", "-1");
    else
        buttonAttributes.Add("onclick", EventCallback.Factory.Create<MouseEventArgs>(this, OnClickAsync));

    <div class="@string.Join(" ", cssClasses)">
        <button type="button" class="expand-button" @attributes="buttonAttributes">
            @RenderFragments.Icon(Entry)

            @if (!isCompact)
            {
                <span>@Entry.Label</span>
            }
        </button>

        @if (!isCompact)
        {
            <button type="button"
                    class="collapse-button"
                    @onclick="@CollapseButtonClickAsync"
                    @onclick:preventDefault
                    @onclick:stopPropagation>

                <MonochromeIcon Name="MonochromeIconName.ExpanderLightLeft" Size="MonochromeIconSize.SmallMedium" />
            </button>
        }
    </div>
}
