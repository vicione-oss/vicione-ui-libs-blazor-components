@using ViciOne.Ui.Blazor.Components.Interfaces

@code
{
    public static RenderFragment<IHasIcon> Icon = hasIcon => __builder =>
    {
        @if (!string.IsNullOrWhiteSpace(hasIcon.IconCssClass))
        {
            var iconCssClasses = new List<string> { "icon" };
            iconCssClasses.AddRange(hasIcon.IconCssClass.Split(" "));

            <div class="@string.Join(" ", iconCssClasses)"></div>
        }
        else if (hasIcon.IconUrl is not null)
        {
            <img class="icon" src="@hasIcon.IconUrl.ToString()" />
        }
        else if (hasIcon.IconData is not null)
        {
            <img class="icon" src="@hasIcon.IconData" />
        }
    };
}
