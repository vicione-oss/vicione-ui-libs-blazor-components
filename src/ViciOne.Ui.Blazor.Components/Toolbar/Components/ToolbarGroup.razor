@{
    List<string> groupCssClasses = ["toolbar-group"];
    if (_hidden)
        groupCssClasses.Add("hidden");
    if (!_initialized)
        groupCssClasses.Add("invisible");
    if (InMenu)
        groupCssClasses.Add("in-menu");
}

@if (!InMenu && AlignRight && !_suppressAlignRight)
{
    <div class="toolbar-group-alignment-spacer" />
}

<div @ref="_container" class=@string.Join(" ", groupCssClasses)>
    <CascadingValue Value="this" IsFixed="true">
        @if (ChildContent != null)
        {
            @ChildContent
        }
    </CascadingValue>
</div>
