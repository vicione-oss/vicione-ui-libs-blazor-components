@page "/text-box"

@using ViciOne.Ui.Blazor.Components.Button
@using ViciOne.Ui.Blazor.Components.Button.Enums
@using ViciOne.Ui.Blazor.Components.TextBox

<h3>Placeholder</h3>

<TextBox Placeholder="e.g. sed diam voluptua" />

<h3>AutoComplete</h3>

<TextBox Placeholder="e.g. any@mail.com" AutoComplete="email" />

<h3>Custom theme</h3>

<div class="custom-theme">
    <TextBox Placeholder=" e.g. sed diam voluptua" />
</div>

<h3>Read-only</h3>

<TextBox ReadOnly="true" Value="Lorem ipsum" />

<h3>Disabled</h3>

<TextBox Enabled="false" Value="Lorem ipsum" />

<h3>Invalid</h3>

<TextBox Value="Lorem ipsum" Valid="false" />

<h3>Password</h3>

<TextBox Password="true" Value="Lorem ipsum" />

<h3>Value / ValueChanging</h3>

<TextBox Placeholder="e.g. sed diam voluptua" Value="@_textBoxInputValue1" ValueChanging="@TextBoxValueChanging" />
contains @_textBoxInputValue1, <code>ValueChanging</code> raised @_textBoxInputValueChangingCount times

<h3>Value / ValueChanged</h3>

<TextBox Placeholder="e.g. sed diam voluptua" Value="@_textBoxInputValue4" ValueChanged="@TextBoxValueChanged" />
contains @_textBoxInputValue4, <code>ValueChanged</code> raised @_textBoxInputValueChangedCount times

<h3>Value / Data binding</h3>

<TextBox Placeholder="e.g. sed diam voluptua" @bind-Value="@_textBoxBoundValue" /> bound to @_textBoxBoundValue

<h3>Value / EnterPressed</h3>

<TextBox Placeholder="e.g. sed diam voluptua" Value="@_textBoxInputValue2" EnterPressed="@((value) => _textBoxInputValue2 = value)" /> contains @_textBoxInputValue2

<h3>Value / FocusLost</h3>

<TextBox Placeholder="e.g. sed diam voluptua" Value="@_textBoxInputValue3" FocusLost="@((value) => _textBoxInputValue3 = value)" /> contains @_textBoxInputValue3

<h3>Unbound / no event</h3>

<TextBox Placeholder="e.g. sed diam voluptua" @ref="_unboundTextBox" />

<p>
    <Button Text="Get value" Size="ButtonSize.Small" OnClick="GetUnboundTextBoxValueClick" />

    @if (_unboundTextBoxValue is not null)
    {
        <span>&nbsp;>&nbsp;</span> @_unboundTextBoxValue
    }
</p>


