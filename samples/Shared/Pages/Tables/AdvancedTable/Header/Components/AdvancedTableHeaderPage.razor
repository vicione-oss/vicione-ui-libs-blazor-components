@page "/tables/advanced-table/header"

@using ViciOne.Ui.Blazor.Components.Tables.AdvancedTable.Components
@using ViciOne.Ui.Blazor.Components.Tables.AdvancedTable.Components.Columns
@using ViciOne.Ui.Blazor.Components.Tables.AdvancedTable.Components.Columns.TableNavigationColumn
@using ViciOne.Ui.Blazor.Components.Tables.AdvancedTable.Components.Footers
@using ViciOne.Ui.Blazor.Components.Tables.Shared.Components.Headers
@using ViciOne.Ui.Blazor.Components.Tables.Shared.Components.Headers.ActionButtons
@using ViciOne.Ui.Blazor.Components.Tables.Shared.Components.Panes
@using ViciOne.Ui.Blazor.Components.Tables.Shared.Enums

<DescriptionBanner>
    The header is an optional render fragment.
    It supports <strong>action buttons</strong> (add, edit, delete, or fully custom) and a <strong>filter box</strong> that filters rows by text.
    A <strong>left pane</strong> can be toggled via a custom action button — it renders beside the table and can hold any content such as details or a form.
</DescriptionBanner>

<h3>TableHeader</h3>

<AdvancedTable ItemsProvider="FilteredItemsProvider" RowClickSelectionEnabled="false" MaximumHeight="300px">
    <Header>
        <TableHeader>
            <ActionButtons>
                <TableAddActionButton OnClick="AddItemAsync" />
                <TableEditActionButton Enabled="false" />
                <TableDeleteActionButton />
                <TableActionButton IconCssClass="@_toggleLeftPaneGridActionButtonIconCssClass" Text="Left pane" OnClick="@ToggleLeftPane" />
            </ActionButtons>
            <Filter>
                <TableFilterBox @bind-Text:get="@_filterText" @bind-Text:set="@ApplyFilter" />
            </Filter>
        </TableHeader>
    </Header>

    <LeftOutlet>
        @if (_hasLeftPane)
        {
            <LeftPane>
                <p>@_lorem1</p>
                <p>@_lorem2</p>
            </LeftPane>
        }
    </LeftOutlet>

    <Columns>
        <AdvancedTableColumn Title="Key" Id="Key">
            <CellContent>
                @GetCellContent(context.Key)
            </CellContent>
        </AdvancedTableColumn>
        <AdvancedTableColumn Title="Value" Id="Value">
            <CellContent>
                @GetCellContent(context.Value)
            </CellContent>
        </AdvancedTableColumn>
        <AdvancedTableColumn Title="Timestamp" Id="Timestamp">
            <CellContent>
                @context.Timestamp
            </CellContent>
        </AdvancedTableColumn>
        <TableNavigationColumn Tooltip="Show details" Navigate="@((ExampleTableItem item) => ShowDetails(item))" />
    </Columns>

    <Footer>
        <TableFooter />
    </Footer>
</AdvancedTable>

@if (_showDetailSource is not null)
{
    <h4>Details</h4>
    <p><code>Id</code> is <code>@_showDetailSource.Id</code></p>
}
