@using ViciOne.Ui.Blazor.Components.DropDown

@{
    var cssClasses = new List<string> { "tag-box" };

    if (!string.IsNullOrWhiteSpace(CssClass))
        cssClasses.AddRange(CssClass.Split(" "));

    if (!Enabled)
        cssClasses.Add("disabled");
}

<div class="@string.Join(" ", cssClasses)" @ref="_tagBox">
     <div class="content">
        @{
            foreach (var tag in Tags)
            {
                var enabled = Enabled && !ReadOnly;

                <TagElement Tag="@tag" Enabled="@enabled" OnDeleteButtonClick="RemoveTagAsync" />
            }

            var inputAttributes = new Dictionary<string, object>();

            if (ReadOnly)
                inputAttributes.Add("readonly", "readonly");
            else if (!Enabled)
                inputAttributes.Add("disabled", "disabled");
        }

        <input class="tag-input"
               type="text"
               @ref="_inputElement"
               @attributes="@inputAttributes"
               @bind="_inputValue"
               @bind:event="oninput"
               @onkeydown="InputKeyDownAsync"
               @onfocus="InputFocusAsync"
               @onfocusout="InputFocusOutAsync" />
    </div>

    <DropDown TItem="string"
              @ref="_dropDown"
              InputElementReference="_inputElement"
              MultiSelection="true"
              Items="@FilterAvailableTags().ToList()"
              @bind-SelectedItems="Tags"
              @bind-SelectedItems:after="NotifyTagsChangedAsync">

        <ItemTemplate>
            @context
        </ItemTemplate>
    </DropDown>
</div>

