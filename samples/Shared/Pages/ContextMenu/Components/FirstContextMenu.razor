@using Shared.Pages.ContextMenu.Models
@using Shared.Pages.ContextMenu.Services
@using ViciOne.Ui.Blazor.Components.ContextMenu.Components

@inherits SpecializedContextMenuWithStateBase<FirstContextMenuContext, FirstContextMenuState>

<ContextMenu @ref="ContextMenu"
             ApplicableTo="new(typeof(FirstContextMenuModel))"
             VisibilityChanged="@ContextMenuVisibilityChangedAsync">

    <ContextMenuHeader Text="Example context menu" />

    <ContextMenuButtonRow>
        <ContextMenuButton Enabled="false"
                           IconData="@_dotIconData" />
        <ContextMenuButton Enabled="false"
                           IconCssClass="@_reloadIcon" />
        <ContextMenuButton Enabled="false"
                           IconCssClass="@_editIcon" />
        <ContextMenuButton IconCssClass="@_editIcon"
                           OnClick="@ContextMenuButtonClickedAsync" />
    </ContextMenuButtonRow>

    <ContextMenuItem BeginGroup="true"
                     Text="Editing">

        <ContextMenuItem BeginGroup="true"
                         IconCssClass="@_editIcon"
                         OnClick="@ContextMenuItemClickedAsync"
                         Text="Add" />
        <ContextMenuItem IconCssClass="@_editIcon"
                         OnClick="@ContextMenuItemClickedAsync"
                         Text="Remove" />
    </ContextMenuItem>

    <ContextMenuItem BeginGroup="true"
                     Enabled="false"
                     IconCssClass="@_editIcon"
                     OnClick="@ContextMenuItemClickedAsync"
                     Text="Select all" />

    <ContextMenuItem Text="Selection">

        <ContextMenuItem IconCssClass="@_editIcon"
                         OnClick="@ContextMenuItemClickedAsync"
                         Text="Select nodes" />

        <ContextMenuItem BeginGroup="true"
                         Enabled="false"
                         IconCssClass="@_editIcon"
                         OnClick="@ContextMenuItemClickedAsync"
                         Text="Select edges" />

        <ContextMenuItem Text="Select faces">

            <ChildContent Context="_">
                <ContextMenuItem IconCssClass="@_editIcon"
                                 OnClick="@ContextMenuItemClickedAsync"
                                 Text="Left face" />

                <ContextMenuItem IconCssClass="@_editIcon"
                                 OnClick="@ContextMenuItemClickedAsync"
                                 Text="Top face" />

                <ContextMenuItem IconCssClass="@_editIcon"
                                 OnClick="@ContextMenuItemClickedAsync"
                                 Text="Right face" />

                <ContextMenuItem IconCssClass="@_editIcon"
                                 OnClick="@ContextMenuItemClickedAsync"
                                 Text="Bottom face" />
            </ChildContent>

        </ContextMenuItem>
    </ContextMenuItem>

    <ContextMenuButtonRow BeginGroup="true"
                          Enabled="false">

        <ContextMenuButton Enabled="true"
                           IconCssClass="@_alignTopIcon"
                           OnClick="@ContextMenuButtonClickedAsync"
                           Title="Align top" />
        <ContextMenuButton IconCssClass="@_alignBottomIcon"
                           OnClick="@ContextMenuButtonClickedAsync"
                           Title="Align bottom" />
        <ContextMenuButton IconCssClass="@_alignLeftIcon"
                           OnClick="@ContextMenuButtonClickedAsync"
                           Title="Align left" />
        <ContextMenuButton IconCssClass="@_alignRightIcon"
                           OnClick="@ContextMenuButtonClickedAsync"
                           Title="Align right" />
    </ContextMenuButtonRow>
</ContextMenu>
