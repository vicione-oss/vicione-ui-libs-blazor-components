{{

func isTypeScriptPropertyInfoAttribute(attribute)
    ret attribute.Name == "TypeScriptPropertyInfo"
end

func isTypeArgument(argument)
    ret argument.Name == "Type"
end

func getNonNullablePropertyType(property)
    if property.Type == "Guid"
        ret "string"
    else if property.Type == "ElementReference"
        ret "HTMLElement"
    else if property.Type | String.StartsWith "DotNetObjectReference<"
        ret "DotNet.DotNetObject"
    else
        attribute = property.Attributes | Array.Filter @isTypeScriptPropertyInfoAttribute | Array.First

        if attribute != null
            typeArgument = attribute.Arguments | Array.Filter @isTypeArgument | Array.First;

            if typeArgument != null
                ret typeArgument.Value
            end
        end

        ret property.Type | Type.ToTypeScriptType | String.Replace " | null" ""
    end
end

func getPropertyType(property)
    if property.Type.IsNullable
        ret "BlazorNullable<" + (getNonNullablePropertyType property) + ">"
    else
        ret getNonNullablePropertyType property
    end
end

for class in data.Classes | Symbols.ThatHaveAttribute "GenerateTypeScriptClass" }}
    {{- capture output -}}
// Auto-generated code
{{ class | Custom.GenerateImports ~}}

export class {{ class.Name }} {
    {{~
    properties = class.Properties | Symbols.ThatArePublic

    if properties | Array.Size > 4 ~}}
    // eslint-disable-next-line max-params
    {{~ end ~}}
    constructor({{ for property in properties }}{{ if !for.first }}
        {{ end -}}
        readonly {{ property.Name | String.ToCamelCase }}: {{ getPropertyType property }}{{ if !for.last }},{{ end ~}}
{{ end }}) {}
}
    {{~ end

    for l in class.Locations
        Save output l.Path + ".ts"
    end
end }}
