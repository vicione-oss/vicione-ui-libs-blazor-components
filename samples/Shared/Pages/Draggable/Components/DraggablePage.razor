@page "/draggable"

@using ViciOne.Ui.Blazor.Components.ComboBox
@using ViciOne.Ui.Blazor.Components.Draggable.Components
@using ViciOne.Ui.Blazor.Components.Draggable.Services
@using ViciOne.Ui.Blazor.Components.SpinEdit
@using ViciOne.Ui.Blazor.Components.Switch
@using ViciOne.Ui.MonochromeIcons.Components
@using ViciOne.Ui.MonochromeIcons.Core.Enums

@implements IDisposable

<TimeTickerDragGhost @ref="TimeTickerDragGhostRef" />

<div class="options">
    <div class="option">
        <label>Draggable</label>
        <Switch @bind-Value="@_draggable" />
    </div>
    <div class="option">
        <label>Modifier key</label>
        <ComboBox Items="@_modifierKeyItems"
                  @bind-Value="@_modifierKey"
                  ValueSelector="@(item => item.Value)"
                  TextSelector="@(item => item.Text)" />
    </div>
    <div class="option">
        <label>Snap to grid</label>
        <Switch @bind-Value="@_snapToGrid" />
    </div>
    <div class="option">
        <label>Grid size</label>
        <SpinEdit @bind-Value="@_gridSize" Interval="10" Minimum="10" Maximum="50" />
    </div>
</div>

<div class="content">
    <div class="draggables">
        <p>Shape with default drag clone:</p>
        <Shape Label="Shape A" Draggable="@_draggable" ModifierKey="@_modifierKey" SnapToGrid="@_snapToGrid"/>

        <p>Shape with time ticker drag ghost:</p>
        <Shape Label="Shape B" Draggable="@_draggable" ModifierKey="@_modifierKey" SnapToGrid="@_snapToGrid" DragGhost="TimeTickerDragGhostRef"/>

        <p>Table where first row has default ghost and second row has the custom drag ghost fixing the width collapse: </p>
        <table class="demo-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                <DraggableRow Name="Alice Anderson" Status="Active" Draggable="@_draggable"/>
                <DraggableRow Name="Bob Brown" Status="Away" Draggable="@_draggable" DragGhost="TableRowDragGhost" />
            </tbody>
        </table>

        <p>Ticket dispenser handing out the next ticket as a drag starts; only the dropzone serving that ticket accepts it:</p>
        <TicketDispenser Draggable="@_draggable" />
    </div>
    <div class="dropzones">
        <Dropzone Label="Dropzone 1" GridSize="@_gridSize" ServedTickets="TicketParity.Odd" />
        <Dropzone Label="Dropzone 2" GridSize="@_gridSize" ServedTickets="TicketParity.Even" />
    </div>
</div>

@if (DropHandler.LastDroppedLabel is not null)
{
    <p class="last-drop-summary">Last drop: <strong>@DropHandler.LastDroppedLabel</strong> → <strong>@DropHandler.LastTargetLabel</strong></p>
}
