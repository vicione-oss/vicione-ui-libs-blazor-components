@using ViciOne.Ui.Blazor.Components.Resizeable.Components
@using ViciOne.Ui.Blazor.Components.Sidebar.Enums
@using ViciOne.Ui.Blazor.Components.Sidebar.Extensions

<div @ref="_sidebarElementReference" class="sidebar @Placement.ToModifierCssClass()" style="--width: @(_width)px">
    @if (ChildContent is not null)
    {
        <div class="content">
            @ChildContent
        </div>
    }

    @if (Mode == SidebarMode.Fluid)
    {
        <div @ref="_resizeContainerElementReference" class="resize-container" style="width: @(_fluidMaximumWidth)px" />

        <CascadingValue TValue="IResizeable" Value="this" IsFixed="true">
            <ResizeHandle Position="Placement.ToResizeHandlePosition()" />
        </CascadingValue>
    }
</div>
