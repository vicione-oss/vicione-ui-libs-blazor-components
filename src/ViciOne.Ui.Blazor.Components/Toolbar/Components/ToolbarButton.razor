@using ViciOne.Ui.Blazor.Components.Toolbar.Enums
@using ViciOne.Ui.MonochromeIcons.Components
@using ViciOne.Ui.MonochromeIcons.Core.Enums

@inherits ToolbarItemBase

@{
    var cssClasses = new List<string> { "toolbar-button" };
    cssClasses.AddRange(GetBaseCssClasses());

    if (Active)
        cssClasses.Add("active");

    var title = string.IsNullOrWhiteSpace(Tooltip) ? Text : Tooltip;
}

<div @ref="_container" tabindex="0" class=@string.Join(" ", cssClasses) title="@title" @onclick="OnClick" @onkeydown="HandleKeyDownAsync">
    @if (IconName != null)
    {
        <MonochromeIcon Name="IconName.Value" Size="MonochromeIconSize.SmallMedium" CssClass="icon" />
    }

    @if (!string.IsNullOrWhiteSpace(Text))
    {
        var showText = TextVisibility == TextVisibility.Always ||
            (TextVisibility == TextVisibility.ToolbarOnly && !InMenu) ||
            (TextVisibility == TextVisibility.MenuOnly && InMenu);

        if (showText)
        {
            <div class="text">
                @Text
            </div>
        }
    }
</div>
