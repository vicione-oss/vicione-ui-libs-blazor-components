@using ViciOne.Ui.Blazor.Components.PropertyGrid.Components.ContextMenu

@typeparam TContext

@if (_state is null) return;

<div class="property-grid">
    <CascadingValue Value="_controller">
        @if (_state.GroupByCategory)
        {
            foreach (var g in _state.Items.ToLookup(p => p.Category).OrderBy(g => g.Key, _state.CategoryComparer ?? DefaultCategoryComparer))
            {
                <PropertyGroup Header="@g.Key" Items="@g" ShowHeader="true" KeepMessages="@_state.KeepMessages" PropertyComparer="@_state.PropertyComparer" />
            }
        }
        else
        {
            <PropertyEntrySet Items="@_state.Items" KeepMessages="@_state.KeepMessages" PropertyComparer="@_state.PropertyComparer" />
        }
    </CascadingValue>
</div>

<PropertyEntryContextMenu ServiceKey="@typeof(TContext)" VisibilityChanged="@ContextMenuVisibilityChanged" />
