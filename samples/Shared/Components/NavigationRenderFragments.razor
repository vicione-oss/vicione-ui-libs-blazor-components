@using Shared.Models

@code
{
    public static RenderFragment Render(NavigationItemDescriptor descriptor)
    {
        if (descriptor.Children.Count > 0)
        {
            return @<NavigationItem Text="@descriptor.Text" Href="@descriptor.Href">
                        @foreach (var childDescriptor in descriptor.Children)
                        {
                            @Render(childDescriptor)
                        }
                    </NavigationItem>;
        }

        return @<NavigationItem Text="@descriptor.Text" Href="@descriptor.Href" />;
    }
}
