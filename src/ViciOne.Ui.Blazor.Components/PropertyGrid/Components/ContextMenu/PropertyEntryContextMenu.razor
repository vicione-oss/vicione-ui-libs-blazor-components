@using ViciOne.Ui.Blazor.Components.ContextMenu.Components
@using ViciOne.Ui.Blazor.Components.PropertyGrid.Models
@using ViciOne.Ui.Blazor.Components.PropertyGrid.Services
@using ViciOne.Ui.Localization.Resources
@using PropertyEntryContextMenuLocalization = ViciOne.Ui.Blazor.Components.Resources.PropertyGrid.ContextMenu.Localization.PropertyEntryContextMenu

@inherits SpecializedContextMenuWithStateBase<PropertyEntryContextMenuContext, PropertyEntryContextMenuState>

<ContextMenu @ref="ContextMenu" VisibilityChanged="@ContextMenuVisibilityChangedAsync">
    <ContextMenuHeader Text="@State.HeaderText" />

    <ContextMenuItem IconCssClass="@_resetIconCssClass"
                     OnClick="@ResetClick"
                     Text="@CommonVocabulary.ResetVerb"
                     Visible="@State.ResetVisible" />

    <ContextMenuItem OnClick="@SetToNullClick"
                     Text="@PropertyEntryContextMenuLocalization.SetToNull"
                     Visible="@State.SetToNullVisible" />
</ContextMenu>
