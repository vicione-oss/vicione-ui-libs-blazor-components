@using ViciOne.Ui.Blazor.Components.TextBox

@inherits PropertyEditorBase<string?>

@{
    var placeholder = Value is null ? Constants.NullPlaceholder : Constants.EmptyPlaceholder;
}

<TextBox Placeholder="@placeholder"
         @bind-Value:get="Value"
         @bind-Value:set="ValueChanged"
         Enabled="@Enabled"
         ReadOnly="@ReadOnly"
         Valid="@Valid"
         UpdateKey="@UpdateKey"
         EnterPressed="@EnterPressed"
         EscapePressed="@EscapePressed"
         @ref="InnerEditorComponentReference" />
