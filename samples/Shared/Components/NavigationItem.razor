@using ViciOne.Ui.MonochromeIcons.Components
@using ViciOne.Ui.MonochromeIcons.Core.Enums

<li>
    <div class="navigation-item">
        @{
            if (ChildContent is not null)
            {
                <button class="expand-collapse-button" @onclick="ExpandCollapseButtonClick">
                    <MonochromeIcon Name="@(_expanded ? MonochromeIconName.ExpanderLightDown : MonochromeIconName.ExpanderLightRight)"
                                    Size="MonochromeIconSize.Small"/>
                </button>
            }
            else
            {
                <MonochromeIcon CssClass="icon" Name="@(MonochromeIconName.PermissionNone)" Size="MonochromeIconSize.Tiny" />
            }

            var linkCssClasses = new List<string> { "link" };

            if (_isCurrent)
                linkCssClasses.Add("current");
        }
        <a class="@string.Join(" ", linkCssClasses)" href="@Href">@Text</a>
    </div>

    @if (ChildContent is not null && _expanded)
    {
        <ul class="nested-navigation-items">
            @ChildContent
        </ul>
    }
</li>
