@using ViciOne.Ui.Blazor.Components.Button
@using ViciOne.Ui.Blazor.Components.Tooltip.Components
@using ViciOne.Ui.MonochromeIcons.Components
@using ViciOne.Ui.MonochromeIcons.Core.Enums

@inherits ErrorBoundary

@if (CurrentException is null)
{
    @ChildContent
}
else
{
    <div class="generic-error-hint">
        <div class="heading">
            <MonochromeIcon Name="MonochromeIconName.GeneralError" Size="MonochromeIconSize.SmallMedium" />

            <span class="text">
                @Localization.Content.Heading
            </span>
        </div>

        <div class="details">
            @Localization.Content.Details
        </div>

        @if (PrepareRecover.HasDelegate)
        {
            <Button CssClass="try-to-recover-button"
                    Text="@Localization.Content.TryAgain"
                    OnClick="@TryToRecoverButtonClickAsync" />
        }

        <div class="only-icon">
            <TooltipContainer>
                <ChildContent>
                    <div @onpointerenter="@(context.OnPointerEnter)"
                         @onpointerleave="@(context.OnPointerLeave)"
                         @onpointermove="@(context.OnPointerMove)"
                         class="tooltipped-content">
                         
                        <MonochromeIcon Name="MonochromeIconName.GeneralError" Size="MonochromeIconSize.SmallMedium" />
                    </div>
                </ChildContent>

                <TooltipContent>
                    <div class="tooltip-content">
                        <strong>@Localization.Content.Heading</strong>

                        <span>@Localization.Content.Details</span>
                    </div>
                </TooltipContent>
            </TooltipContainer>
        </div>
    </div>
}
