@using ViciOne.Ui.MonochromeIcons.Components
@using ViciOne.Ui.MonochromeIcons.Core.Enums

<div @ref="_container" class="toolbar">
    <div class="item-container">
        <CascadingValue Value="this" IsFixed="true">
            @ChildContent
        </CascadingValue>
    </div>

    @if (_itemsInMenuCount > 0)
    {
        <div class="menu-container" @onclick="ShowMenuAsync">
            <MonochromeIcon Name="MonochromeIconName.KebabMenu" Size="MonochromeIconSize.SmallMedium"/>

            <div @ref="_menu" class="menu" tabindex="-1" @onclick:stopPropagation>
                <CascadingValue Value="this" IsFixed="true">
                    <CascadingValue Name="InMenu" Value="true" IsFixed="true">
                        @ChildContent
                    </CascadingValue>
                </CascadingValue>
            </div>
        </div>
    }
</div>
