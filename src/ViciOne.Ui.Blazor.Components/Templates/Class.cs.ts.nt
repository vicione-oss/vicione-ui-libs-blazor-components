{{

func isTypeScriptPropertyInfoAttribute(attribute)
    ret attribute.Name == "TypeScriptPropertyInfo"
end

func isTypeArgument(argument)
    ret argument.Name == "Type"
end

func getPropertyType(property)
    if property.Type.IsNullable
        # Use "null" instead of "undefined" because this is standard practice in JS interop
        # and is the correct choice for parameters; in JavaScript, "null" inherently signifies
        # the absence of a value, whereas "undefined" indicates that something is not defined,
        # which cannot be the case for generated constructor parameters.
        nullability = " | null"
    else
        nullability = ""
    end

    if property.Type == "Guid"
        ret "string" + nullability
    else if property.Type == "ElementReference"
        ret "HTMLElement" + nullability
    else if property.Type | String.StartsWith "DotNetObjectReference<"
        ret "DotNet.DotNetObject" + nullability
    else
        attribute = property.Attributes | Array.Filter @isTypeScriptPropertyInfoAttribute | Array.First

        if attribute != null
            typeArgument = attribute.Arguments | Array.Filter @isTypeArgument | Array.First;

            if typeArgument != null
                ret typeArgument.Value + nullability
            end
        end

        typeScriptType = property.Type | Type.ToTypeScriptType

        ret typeScriptType
    end
end

for class in data.Classes | Symbols.ThatHaveAttribute "GenerateTypeScriptClass" }}
    {{- capture output -}}
// Auto-generated code
{{ class | Custom.GenerateImports ~}}

export class {{ class.Name }} {
    {{~

    lineBreakAfterLastConstructorParameter = false
    previousWasNullable = false

    properties = class.Properties | Symbols.ThatArePublic

    if properties | Array.Size > 4 ~}}
    // eslint-disable-next-line max-params
    {{~ end ~}}
    constructor({{ for property in properties }}{{ if !for.first && !property.Type.IsNullable }}
        {{ end -}}
        {{- if property.Type.IsNullable }}
            {{~ if for.first ~}}
                {{~ lineBreakAfterLastConstructorParameter = true ~}}
            {{~ else if !previousWasNullable ~}}

            {{~ end ~}}
        // eslint-disable-next-line @typescript-eslint/no-restricted-types
        {{ end -}}
        readonly {{ property.Name | String.ToCamelCase }}: {{ getPropertyType property }}{{ if !for.last }},{{ end ~}}
        {{~ if property.Type.IsNullable && !for.last ~}}

        {{~ end ~}}
        {{~ previousWasNullable = property.Type.IsNullable ~}}
{{ end
    if lineBreakAfterLastConstructorParameter }}
    {{ end }}) {}
}
    {{~ end

    for l in class.Locations
        Save output l.Path + ".ts"
    end
end }}
