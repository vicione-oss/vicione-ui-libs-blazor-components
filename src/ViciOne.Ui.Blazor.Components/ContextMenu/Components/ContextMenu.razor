@using Microsoft.AspNetCore.Components.Sections

@{
    // Lets OnAfterRenderAsync() tell whether this render already contains the items of a pending show.
    _renderedRequestVersion = _requestVersion;

    // Lets OnAfterRenderAsync() report the visibility once it is on screen.
    _renderedVisible = _visible;

    var attributes = new Dictionary<string, object>();

    var styles = new Dictionary<string, object>();

    if (!_visible)
        styles.Add("visibility", "hidden");

    if (_position is not null)
        styles.Add("transform", $"translate({_position.X}px, {_position.Y}px)");

    if (styles.Count > 0)
        attributes.Add("style", string.Join("; ", styles.Select(s => $"{s.Key}: {s.Value}")));
}

<SectionContent SectionId="this">
    <div role="menu" class="context-menu" @attributes="@attributes" @oncontextmenu:preventDefault @ref="_elementReference">
        <ul role="none">

            <CascadingValue Value="@_coordinator" IsFixed="true">
                <CascadingValue Value="@this" Name="@Constants.CascadingParameterNames.ParentContextMenu" IsFixed="true">
                    <CascadingValue Value="@_itemFilter">
                        <CascadingValue Value="ApplicableTo">
                            @if (ChildContent is not null)
                            {
                                @ChildContent
                            }
                        </CascadingValue>
                    </CascadingValue>
                </CascadingValue>
            </CascadingValue>
        </ul>
    </div>
</SectionContent>
