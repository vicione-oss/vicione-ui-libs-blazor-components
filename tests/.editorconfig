[*.cs]
dotnet_diagnostic.IDE0120.severity = warning # Simplify LINQ expression

dotnet_diagnostic.CA1515.severity = none # Because an application's API isn't typically referenced from outside the assembly, types can be made internal
dotnet_diagnostic.CA1812.severity = none # Avoid uninstantiated internal classes
dotnet_diagnostic.CA1822.severity = warning # Mark members as static
dotnet_diagnostic.CA1826.severity = warning # Use property instead of Linq Enumerable method
dotnet_diagnostic.CA1849.severity = warning # Call async methods when in an async method
dotnet_diagnostic.CA1859.severity = warning # Use concrete types when possible for improved performance
dotnet_diagnostic.CA2251.severity = warning # Use 'string.Equals' instead of comparing the result of 'string.Compare' to 0

dotnet_diagnostic.SYSLIB1006.severity = warning # Multiple logging methods cannot use the same event ID

# https://aka.ms/editorconfigdocs

[**{Tests}*.cs]

#
# Configure IDE1006 to somewhat check snake case naming for test methods.
# ===========================

# Define the 'test_method' symbol group:
dotnet_naming_symbols.test_method.applicable_kinds = method
dotnet_naming_symbols.test_method.applicable_accessibilities = public
dotnet_naming_symbols.test_method.required_modifiers = 

# Defining the 'test_method_naming_style' naming style
dotnet_naming_style.test_method_naming_style.capitalization = first_word_upper
dotnet_naming_style.test_method_naming_style.word_separator = _
dotnet_naming_style.test_method_naming_style.required_suffix = 

# Defining the 'test_method_naming_rule' naming rule
dotnet_naming_rule.test_method_naming_rule.symbols  = test_method
dotnet_naming_rule.test_method_naming_rule.style    = test_method_naming_style
dotnet_naming_rule.test_method_naming_rule.severity = default

#
# Configure IDE1006 in a way that "Naming rule violation: Missing suffix: 'Async'" is not shown anymore
# for facts and theories. This is done by relying on the rule order functionality where declaring a more
# specific naming rule "async_facts_or_theories_naming_rule" overrides the default one shipped with Roslyn.
#
# Inspired by https://learn.microsoft.com/de-de/dotnet/fundamentals/code-analysis/style-rules/naming-rules#example-public-member-capitalization
# ===========================

# Defining the 'async_facts_or_theories' symbol group
dotnet_naming_symbols.async_facts_or_theories.applicable_kinds = method
dotnet_naming_symbols.async_facts_or_theories.applicable_accessibilities = public
dotnet_naming_symbols.async_facts_or_theories.required_modifiers = async

# Defining the 'async_facts_or_theories_naming_style' naming style
dotnet_naming_style.async_facts_or_theories_naming_style.capitalization = first_word_upper
dotnet_naming_style.async_facts_or_theories_naming_style.required_suffix = 

# Defining the 'async_facts_or_theories_naming_rule' naming rule
dotnet_naming_rule.async_facts_or_theories_naming_rule.symbols  = async_facts_or_theories
dotnet_naming_rule.async_facts_or_theories_naming_rule.style = async_facts_or_theories_naming_style
dotnet_naming_rule.async_facts_or_theories_naming_rule.severity = default

#
# Configure IDE1006 to allow CamelCase (PascalCase) for private const fields.
# This allows patterns like "private const string CssSelector" without s_ prefix.
# ===========================

# Defining the 'private_const_fields' symbol group
dotnet_naming_symbols.private_const_fields.applicable_kinds = field
dotnet_naming_symbols.private_const_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_const_fields.required_modifiers = const

# Defining the 'private_const_fields_naming_style' naming style (PascalCase, no prefix)
dotnet_naming_style.private_const_fields_naming_style.capitalization = pascal_case
dotnet_naming_style.private_const_fields_naming_style.required_prefix = 

# Defining the 'private_const_fields_naming_rule' naming rule
dotnet_naming_rule.private_const_fields_naming_rule.symbols = private_const_fields
dotnet_naming_rule.private_const_fields_naming_rule.style = private_const_fields_naming_style
dotnet_naming_rule.private_const_fields_naming_rule.severity = default
