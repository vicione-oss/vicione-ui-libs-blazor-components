@using ViciOne.Ui.Blazor.Components.Switch.Extensions

@{
    var cssClasses = new List<string> { "switch", Size.ToModifierCssClass() };

    if (Value)
        cssClasses.Add("on");

    if (!Enabled)
        cssClasses.Add("disabled");

    if (!string.IsNullOrWhiteSpace(CssClass))
        cssClasses.AddRange(CssClass.Split(" "));
}

<button type="button" class="@string.Join(" ", cssClasses)" @onclick="@ButtonClickAsync">
    <div class="thumb" />
</button>
