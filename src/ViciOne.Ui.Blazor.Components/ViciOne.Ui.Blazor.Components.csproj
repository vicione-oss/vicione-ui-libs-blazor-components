<Project Sdk="Microsoft.NET.Sdk.Razor">

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <PropertyGroup>
    <!-- https://github.com/koenvzeijl/AspNetCore.SassCompiler/issues/160#issuecomment-2464275724 -->
    <SassCompilerEnableWatcher>false</SassCompilerEnableWatcher>

    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>C:\temp</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AspNetCore.SassCompiler" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.Components.QuickGrid" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <PackageReference Include="Microsoft.TypeScript.MSBuild">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NTypewriter.CodeModel">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="NTypewriter.SourceGenerator">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Tenekon.MSBuild.Packaging.ProjectBuildInPackage">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="ViciOne.Ui.Design">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="ViciOne.Ui.Localization" />
    <PackageReference Include="ViciOne.Ui.MonochromeIcons.Components" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ViciOne.Ui.Blazor.Components.Resources\ViciOne.Ui.Blazor.Components.Resources.csproj" PrivateAssets="all" />
  </ItemGroup>

  <!-- https://github.com/tenekon/Tenekon.MSBuild.Packaging.ProjectBuildInPackage/issues/6#issuecomment-3969741425 -->
  <PropertyGroup Condition="'$(PREVENT_BUILD_PROJECT_REFERENCES_WHEN_TENEKON_IS_USED)' != ''">
    <BuildProjectReferences>false</BuildProjectReferences>
  </PropertyGroup>

  <!-- Prevent Microsoft.NET.Sdk.Razor from copying unnecessary file -->
  <ItemGroup>
    <Content Update="sasscompiler.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" Pack="False" />
    <Content Update="package*.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" Pack="False" />
    <Content Update="tsconfig.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" Pack="False" />
  </ItemGroup>

  <!-- NTypewriter.SourceGenerator configuration -->
  <ItemGroup>
    <AdditionalFiles Include="PropertyGrid\Extensions\Templates\IServiceCollectionExtensions.cs.nt" />
    <AdditionalFiles Include="PropertyGrid\Services\TypeDescriptors\Templates\NumericValueTypeDescriptor.cs.nt" />
    <AdditionalFiles Include="SpinEdit\Extensions\Templates\IServiceCollectionExtensions.cs.nt" />
    <AdditionalFiles Include="SpinEdit\Services\Behaviors\Templates\NumericSpinBehavior.cs.nt" />
    <AdditionalFiles Include="Templates\Class.cs.ts.nt" />
    <AdditionalFiles Include="Templates\Enum.cs.ts.nt" />
  </ItemGroup>

  <ItemGroup>
    <GeneratedCsFile Include="$(ProjectDir)\**\*.g.cs" Exclude="$(ProjectDir)\obj\**\*.g.cs" />
  </ItemGroup>

  <Target Name="HideGeneratedCsFilesFromCompilerBeforeBuild" Outputs="%(GeneratedCsFile.Identity)" BeforeTargets="BeforeBuild">
    <PropertyGroup>
      <_GeneratedCsFileToHide>%(GeneratedCsFile.RecursiveDir)%(GeneratedCsFile.Filename)%(GeneratedCsFile.Extension)</_GeneratedCsFileToHide>
    </PropertyGroup>

    <ItemGroup>
      <Compile Remove="$(_GeneratedCsFileToHide)" Condition="Exists($(_GeneratedCsFileToHide))" />
    </ItemGroup>
  </Target>

  <Target Name="MoveGeneratedCsTempFiles" AfterTargets="Build;Rebuild">
    <ItemGroup>
      <GeneratedCsTempFiles Include="$(ProjectDir)\**\*.g.cs.tmp" />
    </ItemGroup>

    <Move SourceFiles="@(GeneratedCsTempFiles)" DestinationFiles="%(RelativeDir)%(Filename)" />
    <Move SourceFiles="PropertyGrid\Extensions\IServiceCollectionExtensions.PropertyGrid.g.cs" DestinationFiles="PropertyGrid\Extensions\IServiceCollectionExtensions.g.cs" Condition="Exists('PropertyGrid\Extensions\IServiceCollectionExtensions.PropertyGrid.g.cs')" />
  </Target>

  <!-- https://github.com/microsoft/TypeScript/issues/57695 -->
  <Target Name="EnforceTypeScriptCompileAfterSourceGenerators" BeforeTargets="PreComputeCompileTypeScriptWithTSConfig" DependsOnTargets="CoreCompile" />

  <PropertyGroup>
    <!--
      Using "dist" instead of "wwwroot" as otherwise the files will be included in NuGet package as "content" and "contentFiles"
      because artifacts from "dotnet-build" include the wwwroot folder and a subsequent "dotnet-pack ... no-build" then handles
      "wwwroot" as it would be handled without Blazor RCL magic, that is, include all files in that folder as content.

      Having generated static web assets included as content in NuGet package is not only increasing the package size unnecessarily,
      it also breaks JSInterop.
    -->
    <GeneratedStaticWebAssetDestinationFolder>dist</GeneratedStaticWebAssetDestinationFolder>
  </PropertyGroup>

