{
  "name": "vicione-blazor-components-root",
  "private": true,
  "workspaces": [
    "src/ViciOne.Ui.Blazor.Components",
    "samples/Shared"
  ],
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.10.0",
    "eslint-config-xo": "^2.0.0",
    "three-dots": "^0.3.2",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "build": "npm --workspaces --if-present run build",
    "lint-root-config": "eslint eslint.config.mjs",
    "lint": "npm run lint-root-config && npm --workspaces --if-present run lint",
    "lint-with-fix": "npm run lint-root-config -- --fix && npm --workspaces --if-present run lint-with-fix"
  }
}
