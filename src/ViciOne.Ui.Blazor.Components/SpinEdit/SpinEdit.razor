@using ViciOne.Ui.Blazor.Components.Extensions
@using ViciOne.Ui.Blazor.Components.Resources.SpinEdit
@using ViciOne.Ui.Blazor.Components.TextBox
@using ViciOne.Ui.MonochromeIcons.Components
@using ViciOne.Ui.MonochromeIcons.Core.Enums
@using SpinButtonLocalization = ViciOne.Ui.Blazor.Components.Resources.SpinEdit.Localization.SpinButton

@typeparam TValue
@typeparam TInterval
@typeparam TLimit

@{
    var cssClasses = new List<string> { "spin-edit" };

    if (_focused)
        cssClasses.Add("focused");

    if (ReadOnly)
        cssClasses.Add("read-only");

    if (!Enabled)
        cssClasses.Add("disabled");

    if (!string.IsNullOrWhiteSpace(CssClass))
        cssClasses.AddRange(CssClass.Split(" "));

    this.WithInputValidationStyling(cssClasses);

    var spinButtonAttributes = new Dictionary<string, object>();
    if (ReadOnly || !Enabled)
        spinButtonAttributes.Add("disabled", "disabled");

    var incrementByText = string.Format(SpinButtonLocalization.IncrementBy, Interval);
    var decrementByText = string.Format(SpinButtonLocalization.DecrementBy, Interval);
}

<div class="@string.Join(" ", cssClasses)"
     @onfocusin="FocusIn"
     @onfocusout="FocusOut"
     @onkeydown="KeyDown"
     @onkeyup="KeyUpAsync"
     @onwheel="WheelAsync"
     @onwheel:preventDefault>

    <TextBox CssClass="input"
             InputMode="decimal"
             AutoComplete="off"
             ReadOnly="ReadOnly"
             Enabled="Enabled"
             Placeholder="@Placeholder"
             Value="@_textBoxValue"
             ValueChanging="TextBoxValueChanging"
             EnterPressed="TextBoxEnterPressedAsync"
             EscapePressed="TextBoxEscapePressedAsync"
             FocusLost="TextBoxFocusLostAsync"
             UpdateKey="@_updateKey"
             @ref="_textBox" />

    <div class="buttons">
        <button type="button" class="spin-button" aria-label="@incrementByText" title="@incrementByText" tabindex="-1" @attributes="spinButtonAttributes" @onclick="IncrementButtonClickAsync">
            <MonochromeIcon CssClass="icon icon--up" Name="MonochromeIconName.Chevron" Size="MonochromeIconSize.Small" />
        </button>

        <button type="button" class="spin-button" aria-label="@decrementByText" title="@decrementByText" tabindex="-1" @attributes="spinButtonAttributes" @onclick="DecrementButtonClickAsync">
            <MonochromeIcon CssClass="icon icon--down" Name="MonochromeIconName.Chevron" Size="MonochromeIconSize.Small" />
        </button>
    </div>
</div>
