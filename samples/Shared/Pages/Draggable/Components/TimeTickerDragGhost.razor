@using ViciOne.Ui.Blazor.Components.Draggable.Components
@using ViciOne.Ui.MonochromeIcons.Components
@using ViciOne.Ui.MonochromeIcons.Core.Enums

@inherits DragGhostBase

<DragGhostContent @ref="Content">
    <span class="ticker-container @_sizeCssModifier @_stateCssModifier">
        <MonochromeIcon CssClass="icon" Name="MonochromeIconName.Timer" />
        <span class="ticker-time">@_currentTime.ToString("HH:mm:ss")</span>
    </span>
</DragGhostContent>
