@page "/combo-box"

@using Shared.Pages.ComboBox.Models
@using ViciOne.Ui.Blazor.Components.Button
@using ViciOne.Ui.Blazor.Components.Button.Enums
@using ViciOne.Ui.Blazor.Components.ComboBox

<h3>Items modeled with <code>@nameof(ComboBoxItem<,>)</code> and data binding</h3>

<ComboBox Items="@_buttonSizeComboBoxItems"
          @bind-Value="@_buttonSize"
          ValueSelector="@(item => item.Value)"
          TextSelector="@(item => item.Text)" />

contains <code>@_buttonSize.GetName()</code>

<Button Size="ButtonSize.Small" Text="Reset selection" OnClick="ResetSelectionButtonClick" />

<h3><code>@nameof(ComboBox<,>.AllowUserInput)</code></h3>

<ComboBox Items="@_customInputComboBoxItems" @bind-Value="@_city" AllowUserInput="true" />

contains <code>@_city</code>

<Button Size="ButtonSize.Small" Text="Reset selection" OnClick="ResetCitySelectionButtonClick" />

<h3><code>Width 200px</code></h3>

<div style="width: 200px;">
    <ComboBox Items="@_connectionComboBoxItems" @bind-Value="@_connection" />
</div>

<h3><code>@nameof(ComboBox<,>.Valid)</code> is false</h3>

<ComboBox Items="@_buttonSizeComboBoxItems"
          Value="ButtonSize.Small"
          ValueSelector="@(item => item.Value)"
          TextSelector="@(item => item.Text)"
          Valid="false" />

<h3><code>@nameof(ComboBox<,>.ReadOnly)</code></h3>

<ComboBox ReadOnly
          Items="@_buttonSizeComboBoxItems"
          Value="ButtonSize.Small"
          ValueSelector="@(item => item.Value)"
          TextSelector="@(item => item.Text)" />

<h3><code>@nameof(ComboBox<,>.Enabled)</code> is false</h3>

<ComboBox Enabled="false"
          Items="@_buttonSizeComboBoxItems"
          Value="ButtonSize.Small"
          ValueSelector="@(item => item.Value)"
          TextSelector="@(item => item.Text)" />

<h3>Value assigned that is not selectable</h3>

<ComboBox Items="@_buttonSizeComboBoxItems.Select(i => new { Value = i.Value.ToString(), Text = i.Text })"
          Value="@("MediumLarge")"
          ValueSelector="@(item => item.Value)"
          TextSelector="@(item => item.Text)" />

<h3>Simple items uniquely convertable via <code>@(nameof(string.ToString))()</code></h3>

<ComboBox Items="@_simpleItems" @bind-Value="@_buttonSize" />

<h3>Items modeled with <code>@nameof(SampleObject)</code>, data binding and no <code>@nameof(ComboBox<,>.ValueSelector)</code></h3>

<ComboBox Items="@_sampleObjects" @bind-Value="@_selectedSampleObject" TextSelector="@(item => item.Name)" />

@if (_selectedSampleObject is not null)
{
    <span> contains <code>@(_selectedSampleObject.Name)</code></span>
}
