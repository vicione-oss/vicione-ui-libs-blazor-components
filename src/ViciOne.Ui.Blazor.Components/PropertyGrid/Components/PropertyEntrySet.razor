@foreach (var item in Items.OrderBy(p => p.DisplayName))
{
    var valueType = item.ValueType;

    var propertyEntryType = typeof(PropertyEntry<>).MakeGenericType(valueType);
    if (propertyEntryType is null)
        continue;

    var propertyEntryParameters = new Dictionary<string, object>
    {
        { nameof(PropertyEntry<object>.IndentationMultiplier), IndentationMultiplier },
        { nameof(PropertyEntry<object>.Visible), Visible },
        { nameof(PropertyEntry<object>.KeepMessages), KeepMessages },
        { nameof(PropertyEntry<object>.PropertyGridItem), item }
    };

    <DynamicComponent Type="@propertyEntryType" Parameters="@propertyEntryParameters" />
}
